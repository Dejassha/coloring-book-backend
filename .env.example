# Copy this file to ".env" and adjust values if needed.

# Port the backend API listens on (4-digit)
PORT=5050

# Frontend origin(s) allowed by CORS (comma-separated for dev + nginx domain)
CLIENT_ORIGIN=http://localhost:3000,http://coloringbook.example.com

# Where coloring pictures live (served as static files at /images)
IMAGES_DIR=./images

# SQLite database file (auto-created) for saved artwork
DB_PATH=./data/coloring.db
